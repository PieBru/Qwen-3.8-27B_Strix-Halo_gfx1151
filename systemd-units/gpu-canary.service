# gpu-canary — userspace GPU-liveness probe; see gpu_canary.py header for the
# full rationale (lockup_timeout=-1 removed kernel-side wedge detection).
# Deploy: cp to ~/.config/systemd/user/ && systemctl --user daemon-reload
[Unit]
Description=gpu_canary — GPU-wedge detector for the lockup_timeout=-1 setup
ConditionPathExists=/sys/module/amdgpu/parameters/lockup_timeout

[Service]
Type=oneshot
# stdlib-only script — no venv/uv dependency, safe from a system timer
# Repo layout differs per box (dev: ~/Piero/Work/<repo>, halo2: ~/<repo>) - resolve both.
ExecStart=/usr/bin/bash -c 'exec /usr/bin/python3 $(ls -d %h/Piero/Work/Qwen-3.8-27B_Strix-Halo_gfx1151 %h/Qwen-3.8-27B_Strix-Halo_gfx1151 2>/dev/null | head -1)/scripts/gpu_canary.py'
